# The SERVER's .env. Copy it to `.env` next to docker-compose.prod.yml and fill it in.
# This example is versioned; the real `.env` NEVER is, anywhere.
#
#   cp .env.server.example .env && nano .env
#
# Different from the development .env: no Stellar seed here, nothing beyond what the agent
# needs to talk to the model and to be talked to only by whom it should.

# ── Required. Without these two, `docker compose up` refuses to start ─────────────

# Your OpenRouter key. Give it a credit limit in the OpenRouter dashboard: it is the only
# ceiling that does not depend on this code behaving.
OPENROUTER_API_KEY=sk-or-v1-...

# The secret CodeZard and the agent share. CodeZard sends it in X-Mirag-Token.
# Generate it, do not invent it:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
MIRAG_TOKEN=

# ── Optional ──────────────────────────────────────────────────────────────────────

# To REHEARSE the deployment without spending or a real key: with this at 1 the scripted
# demos answer and the model is never called. It checks that the image pulls, that the
# network works and that the token applies, before anything real. Remove it (or 0) in
# production.
# MIRAG_OFFLINE=1

# Which version to run. `latest` is the last one published; to go back, put the short sha
# scripts/publish.sh printed and pull + up again.
# MIRAG_TAG=latest

# Where to pull it from. Only if you change registry or account.
# MIRAG_IMAGEN=andreajunes/agente-backend

# ── Only for the `identidad` profile ─────────────────────────────────────────────
# The on-chain identity is SHOWN with unsigned reads, so the public key and the id are
# enough. The seed does NOT go here: it is not needed, and putting it here would hand the
# ability to sign to a machine that has no reason to have it.
# STELLAR_PUBLIC_KEY=G...
# STELLAR_AGENT_ID=26
