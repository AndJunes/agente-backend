# What does NOT enter the build context. An image is published and shared: whatever gets in
# travels to every registry it is pushed to and stays in its layers even if a later step
# deletes it. The Dockerfile only copies src/, and this is the second lock on the door.

# Secrets. Never, for any reason.
.env
.env.*
!.env.example

# The repository itself: history, remotes and git credentials have no business inside
.git
.gitignore

# Virtual environments and interpreter output from the host
.venv
**/.venv
venv
**/__pycache__
**/*.py[cod]
.mypy_cache
.ruff_cache
.pytest_cache

# Runtime output: the image starts clean
var/
*.log
*.bak

# System and editor noise
.DS_Store
.idea
.vscode

# Dead weight for RUNNING: they stay in git, where they are useful. Production reads the
# measured gains from src/mirag/resources/feature_gains.json, not from benchmarks/.
benchmarks/
docs/
reports/
scripts/
tests/
