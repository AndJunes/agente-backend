OPENROUTER_API_KEY=sk-or-v1-...

# Modelo gratuito para pruebas. Sin esto se usa el de pago por defecto.
# MIRAG_MODELO=openrouter/free

# Secreto compartido con el servidor de CodeZard (cabecera X-Mirag-Token). Sin esto el
# servidor queda abierto a quien alcance su puerto, y lo avisa al arrancar.
# Generalo con: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# MIRAG_TOKEN=

# ── Capa blockchain (opcional) ────────────────────────────────────────────────
# Sin esto, la capa queda apagada y la pagina no muestra el panel. Para encenderla:
#   MIRAG_BLOCKCHAIN=testnet
# La clave se genera con:
#   uv run --project blockchain python demos/blockchain_agent_demo.py --crear
# NUNCA la pongas en .env.example ni en ningun archivo versionado.
STELLAR_PUBLIC_KEY=G...
STELLAR_SECRET_KEY=S...
STELLAR_AGENT_ID=
STELLAR_TX_REGISTRO=
STELLAR_TX_WALLET=
