# Copy to .env (never commit .env). Existing environment variables win over this file.

# ── Model ─────────────────────────────────────────────────────────────────────
# The lock: while MIRAG_OFFLINE=1 no real model is ever called. Set 0 to spend for real.
MIRAG_OFFLINE=1
OPENROUTER_API_KEY=sk-or-v1-...
MIRAG_MODEL=anthropic/claude-haiku-4.5
# Free models for trying it out (20 requests/minute, 50/day):
# MIRAG_MODEL=openrouter/free
# Any provider speaking the chat/completions dialect (NVIDIA, Groq, Gemini...):
# MIRAG_LLM_URL=https://openrouter.ai/api/v1/chat/completions
# Spending cap per request (USD). 0 = no cap, accounting only.
MIRAG_BUDGET_USD=0.50

# ── Execution ─────────────────────────────────────────────────────────────────
# Off: code and tests are delivered WITHOUT running them (the QA agent's job) and the verdict
# is "not executed". `mirag demo` and the benchmarks switch it on by themselves.
MIRAG_EXECUTION=off

# ── Server and locale ─────────────────────────────────────────────────────────
MIRAG_HOST=127.0.0.1
MIRAG_PORT=8000
# Shared secret the caller sends in X-Mirag-Token. Empty = open to whoever reaches the port.
# Generate it with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# MIRAG_TOKEN=
# Default locale when the request says nothing: en | es
MIRAG_LOCALE=en
# Where outputs, artifacts and traces go (default: ./var in a checkout, ~/.mirag installed)
# MIRAG_DATA_DIR=./var

# ── Optional Stellar layer ────────────────────────────────────────────────────
# Off unless set to testnet. The key is generated with:
#   python scripts/blockchain_agent_demo.py --create
# NEVER put a real secret in .env.example or in any versioned file.
MIRAG_BLOCKCHAIN=off
STELLAR_PUBLIC_KEY=G...
STELLAR_SECRET_KEY=S...
STELLAR_AGENT_ID=
STELLAR_REGISTRATION_TX=
STELLAR_WALLET_TX=
