# Copy to .env (never commit .env). Existing environment variables win over this file.

# ── Model ─────────────────────────────────────────────────────────────────────
# The lock: while MIRAG_OFFLINE=1 no real model is ever called. Set 0 to spend for real.
MIRAG_OFFLINE=1
OPENROUTER_API_KEY=sk-or-v1-...
MIRAG_MODEL=anthropic/claude-haiku-4.5
# Behind `mirag_manager` (CodeZard) the backend and the PM can each have their own model.
# Unset, both use MIRAG_MODEL.
# MIRAG_BACKEND_MODEL=
# MIRAG_PM_MODEL=
# Free models for trying it out (20 requests/minute, 50/day):
# MIRAG_MODEL=openrouter/free
# Any provider speaking the chat/completions dialect (NVIDIA, Groq, Gemini...):
# MIRAG_LLM_URL=https://openrouter.ai/api/v1/chat/completions
# Spending cap per request (USD). 0 = no cap, accounting only.
MIRAG_BUDGET_USD=0.50

# ── Execution ─────────────────────────────────────────────────────────────────
# Off: code and tests are delivered WITHOUT running them (the QA agent's job) and the verdict
# is "not executed". `mirag demo` and the benchmarks switch it on by themselves.
MIRAG_EXECUTION=off

# Where a probe actually runs. "subprocess" (default): the host, allow-listed and stripped
# down. "docker": a disposable, network-isolated container per probe, built from
# docker/runner.Dockerfile with a curated set of libraries baked in (fastapi, flask, requests,
# httpx, sqlalchemy, pytest...) — build it once with `make runner-image`, then set this. Needs
# Docker Desktop/Engine reachable from wherever `mirag serve` runs; not guaranteed everywhere,
# hence the safe default.
# MIRAG_EXECUTION_BACKEND=docker
# MIRAG_DOCKER_IMAGE=mirag-runner:latest
# MIRAG_DOCKER_MEMORY=512m
# MIRAG_DOCKER_CPUS=1.0
# MIRAG_DOCKER_PIDS_LIMIT=128

# ── Server and locale ─────────────────────────────────────────────────────────
MIRAG_HOST=127.0.0.1
# 8000 is right for `mirag serve` on its own. Behind CodeZard (`python -m mirag_manager serve`)
# use 8100 instead: the gateway already owns 8000 and this is the port its .env points at.
MIRAG_PORT=8000
# Shared secret the caller sends in X-Mirag-Token. Empty = open to whoever reaches the port.
# Generate it with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Behind CodeZard it is the SAME value as MIRAG_TOKEN in CodeZard/.env: one process, one token.
# MIRAG_TOKEN=
# Default locale when the request says nothing: en | es
MIRAG_LOCALE=en
# Where outputs, artifacts and traces go (default: ./var in a checkout, ~/.mirag installed)
# MIRAG_DATA_DIR=./var

# ── Optional Stellar layer ────────────────────────────────────────────────────
# Off unless set to testnet. The key is generated with:
#   python scripts/blockchain_agent_demo.py --create
# NEVER put a real secret in .env.example or in any versioned file.
MIRAG_BLOCKCHAIN=off
STELLAR_PUBLIC_KEY=G...
STELLAR_SECRET_KEY=S...
STELLAR_AGENT_ID=
STELLAR_REGISTRATION_TX=
STELLAR_WALLET_TX=

# Off by default. Lets a caller with the token run npm/node/python/curl in a COPY of a delivered
# project (POST /api/v1/artifacts/{id}/exec). Not a sandbox: it runs as this user, with this network.
# To use it from the CodeZard screen, the gateway needs GATEWAY_ORCHESTRATION__CONSOLE=true too.
# -- Dependency install: what turns "it does not run here" into tests that ran ---
#
# A generated project that imports fastapi used to top out at VALIDATED on a machine where
# fastapi is not installed: the code compiled, its imports resolved, and its tests were never
# run. That ceiling is honest for a machine that cannot install anything, and it was the FIRST
# answer everywhere. Now the declared dependencies are installed and the analyzer is asked
# again; if the install fails, the run lands exactly where it used to, with the log saying why.
#
# ON by default, which is not the exception to the rest of these defaults it looks like: it can
# only ever happen inside MIRAG_EXECUTION (off) AND inside MIRAG_EXECUTION_BACKEND=docker.
# Installing a generated project's dependencies means fetching third-party code a model chose,
# and there is exactly one place that belongs: the disposable container that was already going
# to run that project's tests. So the packages go into a DOCKER VOLUME mounted read-only into
# that container — never on the host, never in this checkout, never in this interpreter. On the
# subprocess backend there is no sandbox, so there is no install and the project keeps its
# honest ceiling. Only requirements.txt, and only pinned package names: every flag and URL in
# that file is refused by name in the trace.
# The volumes are cached and labelled `mirag.deps=1`; remove them with `make clean-deps`.
MIRAG_INSTALL_DEPENDENCIES=1
# Wall clock for ONE install. The run's own deadline is the real bound; this stops a single
# wheel that will not build from eating all of it.
MIRAG_INSTALL_TIMEOUT_S=300

# Repair attempts PER MOTIVE (syntax, broken imports, failing tests), spent by the convergence
# loop. Per motive, so a project that needed two syntax repairs does not reach its failing
# tests with nothing left. 0 delivers whatever the generator produced, unrepaired.
MIRAG_MAX_REPAIRS=3

MIRAG_CONSOLE=off
